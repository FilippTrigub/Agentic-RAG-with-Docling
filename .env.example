# Copy to .env and fill values

# Google Generative AI (embeddings: models/gemini-embedding-001)
# Docs: https://python.langchain.com/api_reference/google_genai/embeddings/langchain_google_genai.embeddings.GoogleGenerativeAIEmbeddings.html
GOOGLE_API_KEY=

# Cerebras (chat model for the agent)
# Docs: https://docs.langchain.com/oss/python/integrations/chat/cerebras
CEREBRAS_API_KEY=

# Optional: tweak index directory (default: data/index/chroma)
# INDEX_DIR=data/index/chroma
